{
  "$schema": "https://docs.renovatebot.io/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "actions/*"
      ],
      "automerge": true,
      "automergeType": "branch",
      "labels": ["dependencies", "github-actions"]
    }
  ],
  "github-actions": {
    "enabled": true
  },
  "prCreation": "not-pending",
  "prPriority": 5,
  "schedule": ["before 5am on monday"],
  "timezone": "Europe/Paris"
}