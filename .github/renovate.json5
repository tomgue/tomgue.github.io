{
  $schema: 'https://docs.renovatebot.com/renovate-global-schema.json',
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      matchPackageNames: [
        'actions/*',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeSchedule: [
        'before 6am on monday',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
      ],
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
  ],
  'github-actions': {
    enabled: true,
    pinDigests: true,
  },
  prCreation: 'not-pending',
  prPriority: 10,
  schedule: [
    'before 5am on monday',
  ],
  timezone: 'Europe/Paris',
}
