/* site.css — surcharges du site, importé en fin de css/main.css */
/* Design System : https://www.hugolify.io/docs/customization/design/design-system/css/ */

@layer tokens {
  :root {
    --code-block-header-color-background: var(--color-background-muted);
    --code-block-header-color-text: var(--color-text);
    --code-block-header-border-radius: var(--radius-surface);
    --code-block-header-border-style: var(--border-style-normal);
    --code-block-header-border-width: var(--border-width-sm);
    --code-block-header-color-border: var(--color-border);
    --code-block-header-font-family: var(--font-family-mono);
    --code-block-header-font-size: var(--font-size-xs);
    --code-block-header-gap: var(--spacing-xs);
    --code-block-header-padding: var(--spacing-xs);
    --code-block-copy-border-style: var(--border-style-normal);
    --code-block-copy-border-width: var(--border-width-md);
    --code-block-copy-padding: var(--spacing-2xs);
    --code-block-copy-border-radius: var(--radius-xs);
    --code-block-copy-background: var(--color-background-muted-hover);
  }

  /* Correction du code inline invisible en dark mode :
     le thème sombre de @uncinq/design-tokens 1.8.x remappe --color-background-muted
     (gray-900) mais pas --color-text-on-muted, qui reste à sa valeur claire (gray-900).
     Voir https://github.com/Hugolify/hugolify-theme-design-system/issues/1 */
  @media (prefers-color-scheme: dark) {
    :root:not([data-color-scheme='light']) {
      --color-text-on-muted: var(--color-gray-200);
    }
  }
}

@layer base {
  /* Code inline : autoriser la césure à l'intérieur d'un token trop long
     pour la ligne. Sans cette règle, un token non-sécable (chemin de
     fichier, variable CSS…) dépasse son paragraphe — ou pousse une cellule
     de tableau au-delà du viewport, une table width:100% restant
     dimensionnée par son contenu — et la page entière devient scrollable
     horizontalement. `anywhere` agit aussi sur la taille min-content,
     ce que `break-word` ne fait pas. Le code des blocs n'est pas
     concerné : il scrolle déjà via pre { overflow-x: auto }. */
  :where(code):not(pre > code) {
    overflow-wrap: anywhere;
  }
}

@layer components {
  .code-block {
    margin-block-start: var(--spacing-md);
    overflow: hidden;

    .code-block-header {
      /* icône du langage + titre sur une seule ligne, alignés à gauche */
      align-items: center;
      background: var(--code-block-header-color-background);
      border: var(--code-block-header-border-width)
        var(--code-block-header-border-style)
        var(--code-block-header-color-border);
      border-radius: var(--code-block-header-border-radius);
      color: var(--code-block-header-color-text);
      display: flex;
      font-family: var(--code-block-header-font-family);
      font-size: var(--code-block-header-font-size);
      gap: var(--code-block-header-gap);
      justify-content: flex-start;
      line-height: 1;
      padding: var(--code-block-header-padding);
    }

    .code-block-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .code-copy {
      align-items: center;
      background: none;

      color: inherit;
      cursor: pointer;
      display: inline-flex;
      margin-inline-start: auto;
      padding: var(--code-block-copy-padding);
      border: var(--code-block-copy-border-width)
        var(--code-block-copy-border-style) var(--code-block-color-border);
      border-radius: var(--code-block-copy-border-radius);

      &:hover {
        background: var(--code-block-copy-background);
      }

      .icon-check {
        display: none;
      }

      &.is-copied {
        .icon-copy {
          display: none;
        }

        .icon-check {
          display: inline-block;
        }
      }
    }
  }

  .alert {
    margin-block: var(--spacing-xs);
  }
  .btn {
    margin-block-start: var(--spacing-xs);
  }
}
